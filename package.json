{
  "name": "ppe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "detect": "cd detect && .venv\\Scripts\\python.exe -m uvicorn server:app --host 127.0.0.1 --port 8765",
    "detect:setup": "cd detect && python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "electron:dev": "concurrently -n vite,electron -c cyan,magenta \"vite\" \"cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 wait-on https://127.0.0.1:5173 && electron .\"",
    "electron:preview": "npm run build && electron ."
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  }
}
